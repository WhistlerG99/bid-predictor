# containers/Docker.inference
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    gcc g++ \
    libfreetype6 libpng16-16 \
    ca-certificates git wget \
 && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 10
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Same requirements you used for training
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir flask joblib pyarrow

ENV MPLBACKEND=Agg
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

WORKDIR /opt/program

# inference.py is in repo root (build context = .)
COPY inference.py /opt/program/inference.py

EXPOSE 8080

LABEL com.amazonaws.sagemaker.capabilities.accept-bind-to-port=true

# 🔑 KEY CHANGE:
# For inference, SageMaker runs: docker run image serve
# This ENTRYPOINT makes that effectively: python inference.py serve
ENTRYPOINT ["python", "/opt/program/inference.py"]
CMD ["serve"]
